# Internal resume checkpoints written next to pipeline outputs (e.g.
# hilfsdateien/prozessbausteine_mapping.json.partial, gpp_ed23_anforderungen.json.partial).
# They are crash-recovery state, not publishable artifacts.
*.partial

# Python
__pycache__/
*.pyc
.venv/

# Download-Cache der ED23-Lücken-Kreuzanalyse (sha256-gepinnte Fremdquellen,
# reproduzierbar via Gpp-ai-tool/scripts/analyze_ed23_coverage.py).
Gpp-ai-tool/.cache/

# Terraform: State enthält die erzeugten Passwörter, tfvars die eigene IP.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars

