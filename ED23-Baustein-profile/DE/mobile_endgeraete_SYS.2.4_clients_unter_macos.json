                          "DET.5.10",
                          "TEST.1.1"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "SYS.2.4.A2",
                "class": "ed23-anforderung",
                "title": "SYS.2.4.A2 Nutzung der integrierten Sicherheitsfunktionen von macOS",
                "props": [
                  {
                    "name": "label",
                    "value": "SYS.2.4.A2"
                  },
                  {
                    "name": "level",
                    "ns": "https://www.bsi.bund.de/ns/grundschutz",
                    "value": "1"
                  },
                  {
                    "name": "modal_verb",
                    "ns": "https://github.com/BSI-Bund/Stand-der-Technik-Bibliothek/tree/main/documentation/namespaces/modal_verbs.csv",
