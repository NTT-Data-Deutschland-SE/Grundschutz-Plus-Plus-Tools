                "title": "SYS.2.4.A12 Firmware-Kennwort und Boot-Schutz auf Macs",
                "props": [
                  {
                    "name": "label",
                    "value": "SYS.2.4.A12"
                  },
                  {
                    "name": "level",
                    "ns": "https://www.bsi.bund.de/ns/grundschutz",
                    "value": "5"
                  },
                  {
                    "name": "modal_verb",
                    "ns": "https://github.com/BSI-Bund/Stand-der-Technik-Bibliothek/tree/main/documentation/namespaces/modal_verbs.csv",
                    "value": "SOLLTE"
                  },
                  {
                    "name": "herkunft",
                    "ns": "https://github.com/NTT-Data-Deutschland-SE/Grundschutz-Plus-Plus-Tools/ns/ed23-baustein",
                    "value": "BSI"
                  },
                  {
                    "name": "rolle",
                    "ns": "https://github.com/NTT-Data-Deutschland-SE/Grundschutz-Plus-Plus-Tools/ns/ed23-baustein",
                    "value": "Benutzende"
                  }
                ],
                "parts": [
                  {
                    "id": "SYS.2.4.A12_anforderung",
                    "name": "overview",
                    "prose": "Auf älteren Macs SOLLTE die Abfrage eines sicheren Firmware-Kennworts im sogenannten „Command-Modus“ aktiviert werden, um ein unberechtigtes Booten des Macs von einem anderen Startlaufwerk zu verhindern. Es SOLLTE geprüft werden, ob über den „Full-Modus“ ein Kennwort bei jedem Startvorgang abgefragt werden sollte. Auf Macs mit T2-Sicherheitschip SOLLTE ein Firmware-Passwort über das Startsicherheitsdienstprogramm gesetzt werden. Die Option „Sicheres Starten: Volle Sicherheit“ SOLLTE aktiviert werden. Die Option „Starten von externen Medien nicht zulassen“ SOLLTE aktiviert werden."
                  }
                ],
                "insert-controls": [
                  {
                    "include-controls": [
                      {
                        "with-ids": [
                          "KONF.2.9",
                          "KONF.5.1.1",
                          "KONF.5.1.2"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
