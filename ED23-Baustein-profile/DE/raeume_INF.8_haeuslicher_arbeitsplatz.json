                "parts": [
                  {
                    "id": "INF.8.A2_anforderung",
                    "name": "overview",
                    "prose": "Es MUSS geregelt werden, welche Datenträger und Unterlagen am häuslichen Arbeitsplatz bearbeitet und zwischen der Institution und dem häuslichen Arbeitsplatz hin und her transportiert werden dürfen. Generell MÜSSEN Datenträger und andere Unterlagen sicher transportiert werden. Diese Regelungen MÜSSEN den Mitarbeitenden in geeigneter Weise bekanntgegeben werden."
                  }
                ],
                "insert-controls": [
                  {
