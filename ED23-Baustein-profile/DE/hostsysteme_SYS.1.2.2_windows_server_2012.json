                  }
                ],
                "parts": [
                  {
                    "id": "SYS.1.2.2.A14_anforderung",
                    "name": "overview",
                    "prose": "Um verschlüsselte Daten zu schützen, SOLLTEN nicht benötigte Server (inklusive virtuelle Maschinen) immer heruntergefahren werden. Dies SOLLTE möglichst automatisiert erfolgen. Die Entschlüsselung der Daten SOLLTE einen interaktiven Schritt erfordern oder zumindest im Sicherheitsprotokoll festgehalten werden."
                  }
                ],
                "insert-controls": [
                  {
