              {
                "id": "APP.7.A3",
                "class": "ed23-anforderung",
                "title": "APP.7.A3 Festlegung der Sicherheitsfunktionen zur Systemintegration",
                "props": [
                  {
                    "name": "label",
                    "value": "APP.7.A3"
                  },
                  {
                    "name": "level",
                    "ns": "https://www.bsi.bund.de/ns/grundschutz",
                    "value": "1"
                  },
                  {
                    "name": "modal_verb",
                    "ns": "https://github.com/BSI-Bund/Stand-der-Technik-Bibliothek/tree/main/documentation/namespaces/modal_verbs.csv",
                    "value": "MUSS"
                  },
                  {
                    "name": "herkunft",
                    "ns": "https://github.com/NTT-Data-Deutschland-SE/Grundschutz-Plus-Plus-Tools/ns/ed23-baustein",
                    "value": "BSI"
                  },
                  {
                    "name": "rolle",
                    "ns": "https://github.com/NTT-Data-Deutschland-SE/Grundschutz-Plus-Plus-Tools/ns/ed23-baustein",
                    "value": "IT-Betrieb"
                  }
                ],
                "parts": [
                  {
                    "id": "APP.7.A3_anforderung",
                    "name": "overview",
                    "prose": "Der IT-Betrieb und die zuständigen Fachverantwortlichen MÜSSEN Anforderungen an die technische Einsatzumgebung der geplanten Individualsoftware erstellen und mit der Software-Entwicklung abstimmen. Aus den Anforderungen MUSS klar hervorgehen: auf was für einer Hardware-Plattform, auf was für einer Software-Plattform (inklusive gesamten Software-Stack), mit welchen zur Verfügung stehenden Ressourcen (z. B. CPU-Cluster oder Arbeitsspeicher), mit welchen Schnittstellen mit anderen IT-Systemen oder Anwendungen sowie mit welchen sich hieraus ergebenen Sicherheitsfunktionen die Anwendung eingesetzt werden soll. Schnittstellen mit anderen IT-Systemen SOLLTEN in standardisierten technischen Formaten modelliert und definiert werden."
                  }
                ],
                "insert-controls": [
                  {
                    "include-controls": [
                      {
                        "with-ids": [
                          "BES.2.1.4.1"
                        ]
                      }
                    ]
