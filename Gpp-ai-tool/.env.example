# --- Zugang zu Gemini (genau eines von beiden) ---
GCP_PROJECT_ID=                 # Gemini Enterprise Agent Platform (ex Vertex AI) über ADC: gcloud auth application-default login
GEMINI_API_KEY=                 # alternativ: Gemini Developer API (AI Studio); nie committen
REGION=global                   # global | eu | us — Argon wird auf allen dreien bedient
# --- Modell ---
GEMINI_MODEL=gemini-4-argon     # das eine Modell; Kosten und Qualität über thinking_level, nie ein zweites Modell
MAKER_THINKING_LEVEL=medium     # low | medium | high — Maker-/Pipeline-Calls (Kandidaten, Reifegrade)
CHECKER_THINKING_LEVEL=high     # Checker-/Verifier-Calls (gleiches Modell, zweite Rolle)
MAX_OUTPUT_TOKENS=65536         # zählt Thinking mit; >= 32768; über 65536 = Long Decode
MAX_CONCURRENT_AI_REQUESTS=5    # Pool-Größe; bei anhaltenden 429 senken, nicht die Retries erhöhen
API_MAX_RETRIES=5               # Obergrenze je Call (transiente Fehler + Schema-Verstöße zusammen)
# --- Lauf ---
TEST=false                      # true: nur wenige Items je Stage, keine Credentials nötig
OVERWRITE_TEMP_FILES=false      # true: vorhandene Ausgaben neu erzeugen (Alias: --fresh)
LOG_LEVEL=INFO                  # DEBUG zeigt jeden Backend-Call (httpx/httpcore, urllib3); beim Start gelesen
# --- Quellen (Pins; nur zusammen ändern) ---
GPP_CATALOG_PIN_COMMIT=
GPP_CATALOG_PIN_SHA256=
ED23_CATALOG_PIN_COMMIT=
ED23_BD_CATALOG_PIN_SHA256=
ED23_PLAIN_CATALOG_PIN_SHA256=
URL_FETCH_TIMEOUT_SECONDS=30
URL_FETCH_RETRIES=3
# --- Ausgabeorte (Default: Repo-Layout) ---
OUTPUT_ROOT=
SDT_HELPER_OUTPUT_DIR=
SDT_PROFILES_REGULAR_DIR=
SDT_PROFILES_PROCESS_DIR=
ED23_PROFILES_DIR=
