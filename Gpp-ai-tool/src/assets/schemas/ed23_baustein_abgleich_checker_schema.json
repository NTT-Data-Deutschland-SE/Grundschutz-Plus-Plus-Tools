{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Checker verdicts for one Anforderung: one verdict per proposed assignment and one for the proposed new control.",
  "properties": {
    "urteile": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control_id": {"type": "string"},
          "urteil": {"type": "string", "enum": ["bestaetigt", "fraglich", "abgelehnt", "unsicher"]},
          "begruendung": {"type": "string"}
        },
        "required": ["control_id", "urteil", "begruendung"]
      }
    },
    "neues_control": {
      "type": "object",
      "properties": {
        "urteil": {"type": "string", "enum": ["bestaetigt", "fraglich", "abgelehnt", "unsicher"]},
        "begruendung": {"type": "string"}
      },
      "required": ["urteil", "begruendung"]
    },
    "gesamt": {"type": "string"}
  },
  "required": ["urteile"]
}
